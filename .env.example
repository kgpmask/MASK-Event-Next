# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# The server checks that MONGO_URL, QUIZ_ID, and ADMIN_SECRET are set on
# startup and exits if any are missing.

# MongoDB connection string used to connect to the database.
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
MONGO_URL=

# Identifier of the current quiz/event. Used to scope records, results,
# and questions, and as the socket.io room name for the live quiz.
# Example: OCAQ-2026
QUIZ_ID=

# Secret key required to promote a user to admin via the /api/promote-admin
# endpoint.
ADMIN_SECRET=

# (Optional) Port the server listens on. Defaults to 3000.
# Example: 3000
# PORT=3000

# (Optional) Runtime mode. Set to "production" for a production build.
# Example: production
# NODE_ENV=production

# Current question number of the live quiz, used to enforce that only one
# question runs at a time. Do NOT set this yourself - it is managed at
# runtime by /api/live/start-question (a number while a question is
# running, "null" when idle).
QUES_NO=null
